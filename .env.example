# Copy this file to .env and fill in your values.

# Your Claude API key from console.anthropic.com (use the hackathon's $100 credit org).
ANTHROPIC_API_KEY=sk-ant-...

# Check your Console's model picker for the exact current model id and paste it here.
# If unset, the backend falls back to CLAUDE_MODEL_DEFAULT in claude_report.py.
CLAUDE_MODEL=

# Shared secret the Android intake app must send in the X-Intake-Token header.
# Keeps randoms on the network from posting fake "messages" into your demo.
INTAKE_SHARED_SECRET=change-me-before-demo
