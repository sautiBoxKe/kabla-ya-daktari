    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- bubble body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M80,50 a26,26 0 1,0 -52,0 a26,26 0 1,0 52,0 z" />
    <!-- bubble tail -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,72 L50,72 L36,85 Z" />
    <!-- cross -->
    <path
        android:fillColor="#4F46E5"
